# ---------------------------------------------------------------------------
# Questboard environment. Copy to .env (pnpm db:setup does this for you).
# Everything here has a free local default; no paid service is required.
# ---------------------------------------------------------------------------

# PostgreSQL connection. `pnpm db:setup` starts a private local cluster on
# port 54329 (under .data/postgres) when nothing is listening there, using the
# PostgreSQL binaries on your machine, or tells you to run `docker compose up -d db`.
# On Neon use the pooled URL here and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://questboard:questboard@127.0.0.1:54329/questboard"
DIRECT_URL="postgresql://questboard:questboard@127.0.0.1:54329/questboard"

# Auth.js. Generate a secret with `openssl rand -base64 32`. AUTH_URL is the
# public origin (set it in production; optional locally).
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional). Leave empty to hide the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email. With RESEND_API_KEY set, mail goes through Resend; otherwise it is
# printed to the console and written to .data/mail/outbox.jsonl.
RESEND_API_KEY=""
EMAIL_FROM="Questboard <hello@questboard.local>"

# Uploads. With S3_BUCKET set, photos go to any S3-compatible store
# (AWS S3, Cloudflare R2, MinIO). Otherwise they are stored in .data/uploads.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for uploaded objects (e.g. an R2 public bucket URL). Leave
# empty to serve objects through /api/uploads.
S3_PUBLIC_URL=""

# Public origin used in emails, invite links and OG images.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for the cron routes (/api/cron/*). Vercel Cron sends it as
# "Authorization: Bearer $CRON_SECRET".
CRON_SECRET="dev-cron-secret"

# Development helpers. Never enable in production.
# ENABLE_DEV_LOGIN shows one-click sign-in for seeded users on /signin and
# exposes /api/dev/mailbox (the local outbox) for end-to-end tests.
ENABLE_DEV_LOGIN="true"

# Comma-separated emails that get admin rights (catalog promotion, terrain
# overrides, report review).
ADMIN_EMAILS="host@questboard.local"
