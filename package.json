{
  "name": "questboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset",
    "db:start": "tsx scripts/db-setup.ts --start-only",
    "game:recompute": "tsx scripts/recompute.ts",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts",
    "jobs:auto-confirm": "tsx scripts/auto-confirm.ts",
    "jobs:imports": "tsx scripts/process-imports.ts",
    "enrich:wikidata": "tsx scripts/enrich-wikidata.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@prisma/client": "6.19.3",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "framer-motion": "12.23.12",
    "lucide-react": "^1.67.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.30",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "^22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "3.2.4"
  }
}
